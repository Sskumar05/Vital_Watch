# =============================================================
#  MERN Patient Monitoring System — Environment Variables
# =============================================================

# Backend Express Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/patient_monitor
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/patient_monitor?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/patient_monitor

# Frontend Vite Configuration
VITE_API_URL=http://localhost:5000

